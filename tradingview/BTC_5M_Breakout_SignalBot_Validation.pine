//@version=6
// 僅供 TradingView Strategy Tester 驗證；本檔沒有 webhook URL、任何 alert 呼叫或派網 API 呼叫。
// 使用前請先閱讀 TRADINGVIEW_SIGNAL_BOT_BREAKOUT_CONTRACT.md。
strategy(
     "BTC 5M Breakout — Signal Bot Validation Only",
     overlay = true,
     pyramiding = 0,
     initial_capital = 1000,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.percent,
     commission_value = 0,
     process_orders_on_close = true,
     calc_on_every_tick = false)

// === 與 Python .env 預設值對齊的策略輸入 ===
bbLength = input.int(20, "布林週期", minval = 2)
bbMultiplier = input.float(2.0, "布林標準差倍數", minval = 0.1, step = 0.1)
rsiLength = input.int(14, "RSI 週期", minval = 2)
rsiLongMin = input.float(55.0, "RSI 做多下限", minval = 0, maxval = 100, step = 0.1)
rsiShortMax = input.float(45.0, "RSI 做空上限", minval = 0, maxval = 100, step = 0.1)

// 這是圖表回測的 ROE 估算槓桿，並不會修改派網或 TradingView 的實際槓桿。
roeLeverage = input.float(5.0, "ROE 估算槓桿", minval = 1.0, step = 0.5)
hardStopRoe = input.float(-8.0, "ROE 硬停損 (%)", step = 0.1)
protectionActivationRoe = input.float(10.0, "ROE 第一段保護啟動 (%)", step = 0.1)
protectionFloorRoe = input.float(5.0, "ROE 第一段保護線 (%)", step = 0.1)
lockProfitPeakRoe = input.float(15.0, "ROE 第二段高水位 (%)", step = 0.1)
lockProfitExitRoe = input.float(10.0, "ROE 第二段鎖利線 (%)", step = 0.1)

// === 指標：使用收盤價；只在已確認的 K 線建立或關閉策略單 ===
basis = ta.sma(close, bbLength)
deviation = bbMultiplier * ta.stdev(close, bbLength, true)
upperBand = basis + deviation
lowerBand = basis - deviation
rsiValue = ta.rsi(close, rsiLength)

isFiveMinute = timeframe.isminutes and timeframe.multiplier == 5
hasIndicators = not na(upperBand) and not na(lowerBand) and not na(rsiValue)
confirmedFiveMinuteBar = barstate.isconfirmed and isFiveMinute and hasIndicators

// Python 的條件使用嚴格大於／小於布林軌，RSI 門檻則包含等號。
longSignal = confirmedFiveMinuteBar and close > upperBand and rsiValue >= rsiLongMin
shortSignal = confirmedFiveMinuteBar and close < lowerBand and rsiValue <= rsiShortMax

// === 兩段式 ROE 狀態 ===
var bool protectionActivated = false
var bool lockProfitPeakReached = false
var string lastExitReason = ""

if strategy.position_size == 0
    protectionActivated := false
    lockProfitPeakReached := false
    lastExitReason := ""

float estimatedRoe = na
if strategy.position_size > 0
    estimatedRoe := (close / strategy.position_avg_price - 1.0) * 100.0 * roeLeverage
else if strategy.position_size < 0
    estimatedRoe := (strategy.position_avg_price / close - 1.0) * 100.0 * roeLeverage

if confirmedFiveMinuteBar and strategy.position_size != 0 and not na(estimatedRoe)
    if estimatedRoe >= protectionActivationRoe
        protectionActivated := true
    if estimatedRoe >= lockProfitPeakRoe
        lockProfitPeakReached := true

    hardStopTriggered = estimatedRoe <= hardStopRoe
    lockProfitTriggered = lockProfitPeakReached and estimatedRoe <= lockProfitExitRoe
    protectionTriggered = protectionActivated and estimatedRoe <= protectionFloorRoe

    // 與 Python 的檢查順序相同：硬停損 → 曾達 +15% 的第二段鎖利 → +10% 後的第一段保護。
    if hardStopTriggered
        lastExitReason := "ROE hard stop"
        strategy.close("LONG", comment = "ROE hard stop")
        strategy.close("SHORT", comment = "ROE hard stop")
    else if lockProfitTriggered
        lastExitReason := "ROE lock profit"
        strategy.close("LONG", comment = "ROE lock profit")
        strategy.close("SHORT", comment = "ROE lock profit")
    else if protectionTriggered
        lastExitReason := "ROE protection floor"
        strategy.close("LONG", comment = "ROE protection floor")
        strategy.close("SHORT", comment = "ROE protection floor")

// 同一時間只允許一筆策略持倉；本階段沒有 alert、webhook 或實盤交易設定。
if confirmedFiveMinuteBar and strategy.position_size == 0
    if longSignal
        strategy.entry("LONG", strategy.long, comment = "BB+RSI long")
    else if shortSignal
        strategy.entry("SHORT", strategy.short, comment = "BB+RSI short")

// === 可視化：協助人工逐筆核對，並不傳送外部訊號 ===
plot(basis, "布林中軌", color = color.new(color.gray, 0))
upperPlot = plot(upperBand, "布林上軌", color = color.new(color.teal, 0))
lowerPlot = plot(lowerBand, "布林下軌", color = color.new(color.orange, 0))
fill(upperPlot, lowerPlot, color = color.new(color.gray, 92), title = "布林區間")

plotshape(longSignal and strategy.position_size == 0, title = "LONG 驗證訊號", text = "LONG", style = shape.labelup, location = location.belowbar, color = color.new(color.teal, 0), textcolor = color.white, size = size.tiny)
plotshape(shortSignal and strategy.position_size == 0, title = "SHORT 驗證訊號", text = "SHORT", style = shape.labeldown, location = location.abovebar, color = color.new(color.orange, 0), textcolor = color.white, size = size.tiny)
plot(estimatedRoe, "收線 ROE 估算 (%)", color = color.new(color.fuchsia, 0), display = display.data_window)

bgcolor(not isFiveMinute ? color.new(color.red, 88) : na, title = "非 5 分鐘圖表警示")
