# 複製為 .env 後，僅在本機或 Render 環境變數填入真正值。
# 絕不可將 .env 提交至 GitHub、截圖或貼到聊天中。
PIONEX_API_KEY=
PIONEX_API_SECRET=

# Telegram 為可選通知功能。Bot Token 與 Chat ID 只能保留在 .env，絕不可提交或截圖。
# 先用 python pionex_breakout_live.py --telegram-test 測試成功後，才改為 true。
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 安全開關：驗證期間務必保持 false。
LIVE_TRADING=false

# 市場掃描與時間框架
KLINE_INTERVAL=5M
LOOP_SECONDS=10
SCAN_COOLDOWN_SECONDS=60
SCAN_TOP_N=30
KLINE_LIMIT=150

# 槓桿與階梯保證金
LEVERAGE=5
# 0 代表可用 USDT 剛好 50 時允許第一階 50 USDT 保證金。
MIN_FREE_BALANCE_BUFFER=0
MAX_TRADES_PER_UTC_DAY=3

# 布林通道 + RSI 雙重確認
BOLLINGER_PERIOD=20
BOLLINGER_STDDEV=2
RSI_PERIOD=14
RSI_LONG_MIN=55
RSI_SHORT_MAX=45

# ROE 風控：-8% 停損；+10% 後保護 +5%；曾達 +15% 回落 +10% 鎖利
STOP_ROE_PCT=-8
PROTECTION_ACTIVATION_ROE_PCT=10
PROTECTION_FLOOR_ROE_PCT=5
LOCK_PROFIT_PEAK_ROE_PCT=15
LOCK_PROFIT_EXIT_ROE_PCT=10

# 執行期檔案（Render 免費方案重啟後不會保留）
BOT_STATE_FILE=pionex_live_state.json
EVENT_LOG_FILE=pionex_live_events.csv
