# Binance USDⓈ-M Futures Demo/Testnet 專用設定。請勿在此或 GitHub 保存任何實際金鑰。
# 僅允許 Binance 官方目前的 Demo/Testnet REST 網域；程式會拒絕舊端點及主網。
BINANCE_TESTNET_BASE_URL=https://demo-fapi.binance.com
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# 預設為 false：只抓 Demo/Testnet 公開 K 線並輸出 DRY_RUN 事件，絕不送單。
TESTNET_TRADING=false

BINANCE_SYMBOL=BTCUSDT
KLINE_INTERVAL=5m
LOOP_SECONDS=10

# 50 USDT 保證金 × 5 倍槓桿 = 約 250 USDT 名義價值。
MARGIN_USDT=50
LEVERAGE=5

BB_LENGTH=20
BB_MULTIPLIER=2
RSI_LENGTH=14
RSI_LONG_MIN=55
RSI_SHORT_MAX=45

STOP_ROE_PCT=-8
PROTECTION_ACTIVATION_ROE_PCT=10
PROTECTION_FLOOR_ROE_PCT=5
LOCK_PROFIT_PEAK_ROE_PCT=15
LOCK_PROFIT_EXIT_ROE_PCT=10

STATE_FILE=binance_testnet_state.json
EVENT_LOG_FILE=binance_testnet_events.csv

# 私人唯讀監控（預設停用）。在網站按「建立本機配對權杖」後，僅把一次性權杖貼入本機 .env。
# 此上傳器只傳帳戶摘要、持倉與策略事件；不會傳送 API Key、Secret、簽名或原始 API 回應。
MONITOR_TELEMETRY_ENABLED=false
MONITOR_INGEST_URL=https://pionexdash-x73yw8sp.manus.space/api/telemetry/ingest
MONITOR_INGEST_TOKEN=
MONITOR_TELEMETRY_TIMEOUT_SECONDS=10
